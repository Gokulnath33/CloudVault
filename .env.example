# =============================================================
# CloudVault Configuration & Real-Time OTP Settings
# =============================================================

# 1. MongoDB Database Configuration
# Local Compass: mongodb://localhost:27017
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/cloudvault_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
DB_NAME=cloudvault_db
SECRET_KEY=replace-with-a-secure-random-secret-key

# -------------------------------------------------------------
# 2. Administrator Alert Settings
ADMIN_PHONE=+919876543210
ADMIN_EMAIL=admin@vault.local

# -------------------------------------------------------------
# 3. Real-Time Gmail / Email OTP Settings
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
GMAIL_SMTP_SERVER=smtp.gmail.com
GMAIL_SMTP_PORT=587

# -------------------------------------------------------------
# 4. Real-Time SMS OTP Settings (Fast2SMS / Twilio)
FAST2SMS_API_KEY=your-fast2sms-api-key

# Twilio (Optional Fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
